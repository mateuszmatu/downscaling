<?xml version="1.0" encoding="UTF-8"?>
<netcdf xmlns="http://www.unidata.ucar.edu/namespaces/netcdf/ncml-2.2">

  <remove type="attribute" name="format"/>
  <!--<attribute name="Conventions" value="CF-1.0"/>-->
  <dimension name="Y" orgName="eta_rho" />
  <dimension name="X" orgName="xi_rho" />
  <dimension name="time" orgName="ocean_time" />
  <dimension name="bnds" length="2"/>
  <variable name="X" orgName="xi_rho" />
  <variable name="Y" orgName="eta_rho" />
  <variable name="projection_stereographic" orgName="projection_stere" />
  <variable name="lat" orgName="lat_rho">
    <attribute name="field" type="string" value="lat, scalar"/>
  </variable>
  <variable name="lon" orgName="lon_rho">
    <attribute name="field" type="string" value="lon, scalar"/>
  </variable>
  <variable name="angle">
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="sea_mask" orgName="mask_rho">
    <attribute name="standard_name" type="string" value="sea_binary_mask"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="h">
    <attribute name="long_name" type="string" value="sea_floor_depth_below_sea_level"/>
    <attribute name="standard_name" type="string" value="sea_floor_depth_below_sea_level"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="zeta">
    <attribute name="long_name" type="string" value="Sea surface height above geoid"/>
    <attribute name="standard_name" type="string" value="sea_surface_elevation"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="w">
    <attribute name="long_name" type="string" value="Sea water z velocity"/>
    <attribute name="standard_name" type="string" value="upward_sea_water_velocity"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="temp">
    <attribute name="long_name" type="string" value="Sea water potential temperature"/>
    <attribute name="standard_name" type="string" value="sea_water_potential_temperature"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="salt">
    <attribute name="long_name" type="string" value="Sea water salinity"/>
    <attribute name="standard_name" type="string" value="sea_water_salinity"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="units" value="1e-3" />
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="u_eastward">
    <attribute name="long_name" type="string" value="Sea water eastward velocity"/>
    <attribute name="standard_name" type="string" value="eastward_sea_water_velocity"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="v_northward">
    <attribute name="long_name" type="string" value="Sea water northward velocity"/>
    <attribute name="standard_name" type="string" value="northward_sea_water_velocity"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <!--<variable name="u">
    <attribute name="long_name" type="string" value="u-momentum component"/>
    <attribute name="standard_name" type="string" value="u-momentum component"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
  <variable name="v">
    <attribute name="long_name" type="string" value="v-momentum component"/>
    <attribute name="standard_name" type="string" value="v-momentum component"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>-->
  <variable name="Uwind">
    <attribute name="standard_name" value="x_wind" />
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
  </variable>
  <variable name="Vwind">
    <attribute name="standard_name" value="y_wind" />
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
  </variable>
  <variable name="time" orgName="ocean_time">
    <attribute name="axis" value="T" type="string" />
    <attribute name="standard_name" value="time" type="string" />
  </variable>
  <variable name="depth">
    <attribute name="axis" value="Z" type="string" />
    <attribute name="standard_name" value="depth" type="string" />
  </variable>
  <variable name="ln_AKs">
    <attribute name="long_name" type="string" value="Ocean vertical salt diffusivity"/>
    <attribute name="standard_name" type="string" value="ocean_vertical_salt_diffusivity"/>
    <attribute name="time" type="string" value="time"/>
    <attribute name="coordinates" type="string" value="lon lat"/>
    <attribute name="grid_mapping" value="projection_stereographic" />
  </variable>
</netcdf>
